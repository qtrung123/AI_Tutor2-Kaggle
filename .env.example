# Copy to .env.local (git-ignored) and fill in real values for local development.
# Real environment variables always take precedence over .env.local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Optional: external PostgreSQL for accounts and all saved app data (conversations, document
# metadata, summaries, flashcards, quizzes, progress, planner, calendar links).
# Leave unset to use the local SQLite file (AI_TUTOR_DATABASE_PATH).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# With DATABASE_URL, document vectors go to the same PostgreSQL (pgvector) and original uploads to a
# private Supabase Storage bucket. The service-role key stays on the server; never expose it.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# AI_TUTOR_STORAGE_BUCKET=ai-tutor-documents
