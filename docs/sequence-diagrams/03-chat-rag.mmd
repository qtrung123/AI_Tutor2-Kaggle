%%{init: {"theme": "neutral", "themeVariables": {"fontFamily": "Times New Roman, serif", "fontSize": "16px", "noteBkgColor": "#f7f7f2", "noteTextColor": "#111111", "noteBorderColor": "#888888", "actorBkg": "#ffffff", "actorBorder": "#333333", "signalColor": "#222222", "signalTextColor": "#111111", "labelBoxBkgColor": "#eeeeee", "activationBkgColor": "#e6e6e6", "activationBorderColor": "#444444"}, "sequence": {"mirrorActors": true, "showSequenceNumbers": true, "messageAlign": "center", "actorMargin": 35, "width": 130, "boxMargin": 8, "noteMargin": 8, "actorFontSize": 16, "messageFontSize": 16, "noteFontSize": 15}}}%%
sequenceDiagram
    autonumber
    actor S as Student
    participant UI as Frontend<br/>(tutor.js)
    participant API as FastAPI<br/>(conversations.py)
    participant RAG as RAG Service<br/>(rag_service.py)
    participant DB as SQLite
    participant VS as ChromaDB
    participant EMB as BGE-M3
    participant LLM as Qwen2.5-7B

    S->>UI: Send question
    opt First message for this document
        UI->>API: POST /api/conversations
        API->>DB: create_conversation()
    end
    UI->>API: POST /conversations/{id}/messages (SSE)
    Note over API: prepare_generation_model()<br/>400 empty / 404 unknown conversation
    API->>RAG: stream_conversation_message()
    RAG->>DB: get_conversation() (last 6 messages)
    API-->>UI: 200 event-stream: start
    Note over API,RAG: RAG events are relayed by the API<br/>(_event_stream) as SSE lines
    alt Conversation has no document
        RAG-->>UI: fixed answer (no LLM)
    else Document selected
        RAG->>VS: similarity search k=4 (owner + document)
        VS->>EMB: embed question
        EMB-->>VS: query vector
        VS-->>RAG: top-4 chunks
        alt No relevant chunk
            RAG-->>UI: fixed answer (no LLM)
        else Chunks found
            Note over RAG: rag_prompt.txt + chunks<br/>+ short history
            RAG->>LLM: ChatOllama.stream(prompt)
            loop Token chunks
                LLM-->>RAG: tokens
                RAG-->>UI: SSE delta
            end
        end
    end
    alt Stop pressed / client disconnected
        Note over RAG: nothing saved
    else Answer complete
        RAG->>DB: add_exchange() (one transaction)
        RAG-->>UI: SSE done (answer, citations)
    end
    UI-->>S: Answer with sources
