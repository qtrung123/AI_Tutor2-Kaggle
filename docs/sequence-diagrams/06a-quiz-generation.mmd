%%{init: {"theme": "neutral", "themeVariables": {"fontFamily": "Times New Roman, serif", "fontSize": "16px", "noteBkgColor": "#f7f7f2", "noteTextColor": "#111111", "noteBorderColor": "#888888", "actorBkg": "#ffffff", "actorBorder": "#333333", "signalColor": "#222222", "signalTextColor": "#111111", "labelBoxBkgColor": "#eeeeee", "activationBkgColor": "#e6e6e6", "activationBorderColor": "#444444"}, "sequence": {"mirrorActors": true, "showSequenceNumbers": true, "messageAlign": "center", "actorMargin": 35, "width": 130, "boxMargin": 8, "noteMargin": 8, "actorFontSize": 16, "messageFontSize": 16, "noteFontSize": 15}}}%%
sequenceDiagram
    autonumber
    actor S as Student
    participant UI as Frontend<br/>(quiz.js)
    participant API as FastAPI<br/>(quiz_generation.py)
    participant QS as Quiz Service<br/>(quiz_service.py)
    participant DB as SQLite
    participant VS as ChromaDB
    participant LLM as Qwen2.5-7B

    S->>UI: Create Quiz (scope, difficulty, count)
    UI->>API: POST /api/quiz/generate
    API->>DB: usable_flashcards()
    alt No flashcards
        API-->>UI: 409 Create Flashcards first
    else Flashcards exist
        Note over API: prepare_generation_model()
        API->>QS: generate_quiz()
        QS->>DB: document + topics
        QS->>VS: topic / document chunks (metadata filter)
        VS-->>QS: chunks
        Note over QS: build_study_units()<br/>detect_quiz_language()
        Note over QS: matching + multi_blank<br/>built from flashcards (no LLM)
        loop Until MC target, stall limit or time budget
            QS->>LLM: MC prompt (stream with deadline)
            LLM-->>QS: candidate questions
            Note over QS: validate_candidate(): quote in context,<br/>structure, duplicates (no LLM)
            QS->>DB: save_quiz_validation_event()
        end
        alt No valid question
            API-->>UI: 422 generation failed
        else ≥ 1 valid question
            QS->>DB: save_quiz() (new quiz_id)
            API-->>UI: 200 quiz (complete / partial)
        end
    end
    UI-->>S: Quiz added to library
