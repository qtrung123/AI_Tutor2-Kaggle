%%{init: {"theme": "neutral", "themeVariables": {"fontFamily": "Times New Roman, serif", "fontSize": "16px", "noteBkgColor": "#f7f7f2", "noteTextColor": "#111111", "noteBorderColor": "#888888", "actorBkg": "#ffffff", "actorBorder": "#333333", "signalColor": "#222222", "signalTextColor": "#111111", "labelBoxBkgColor": "#eeeeee", "activationBkgColor": "#e6e6e6", "activationBorderColor": "#444444"}, "sequence": {"mirrorActors": true, "showSequenceNumbers": true, "messageAlign": "center", "actorMargin": 35, "width": 130, "boxMargin": 8, "noteMargin": 8, "actorFontSize": 16, "messageFontSize": 16, "noteFontSize": 15}}}%%
sequenceDiagram
    autonumber
    actor S as Student
    participant UI as Frontend<br/>(subjects.js)
    participant API as FastAPI<br/>(api/subjects.py)
    participant SS as Subject Store<br/>(subject_store.py)
    participant DB as SQLite<br/>(subjects,<br/>indexed_documents)

    S->>UI: Open library
    UI->>API: GET /api/subjects
    API->>SS: list_subjects()
    SS->>DB: SELECT subjects + document ids
    API-->>UI: subjects with document counts

    alt Create
        S->>UI: Enter name (+ color)
        UI->>API: POST /api/subjects
        API->>SS: create_subject()
        alt Name already used (case-insensitive)
            API-->>UI: 409 Conflict
        else
            SS->>DB: INSERT subjects
            API-->>UI: 201 subject
        end
    else Rename / recolor
        S->>UI: Edit subject
        UI->>API: PATCH /api/subjects/{id}
        API->>SS: update_subject()
        SS->>DB: UPDATE subjects
        API-->>UI: 200 / 404 / 409
    else Assign / move / unassign documents
        S->>UI: Choose documents + subject
        UI->>API: POST /api/subjects/assign
        API->>SS: assign_documents()
        SS->>DB: UPDATE indexed_documents.subject_id<br/>(all or nothing)
        API-->>UI: 200 subjects / 404
    else Delete
        S->>UI: Delete subject
        UI->>API: DELETE /api/subjects/{id}
        API->>SS: delete_subject()
        SS->>DB: unassign documents + DELETE subject
        Note over SS: document data is kept
        API-->>UI: 200 unassigned document ids
    end
    UI-->>S: Updated library groups
